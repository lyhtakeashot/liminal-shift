        { "pos": [900, 545], "title": "老井", "reach": 40, "text": "井口是木架，绳子在井沿上磨出一道沟。水面离地不到一尺。" },
        { "pos": [1100, 220], "title": "田·东", "reach": 44, "text": "两片田，土是干的。田埂上的草被踩出一条路，通向磨坊。" },
        { "pos": [1392, 218], "title": "田·西", "reach": 44, "text": "靠西那片田，地势低些。田埂上有新踩的脚印，往坝那边去。" },
        { "pos": [196, 92], "title": "坝", "reach": 70, "text": "一道石坝横在河身里。水面在坝前抬高了几寸，从坝顶漫过去。" },
        { "pos": [700, 602], "title": "界碑", "reach": 34, "text": "半截石碑，埋在土里一尺。字被凿过，只剩两个：「周界」。石头这一面朝北，刻的那一面朝着沈家的屋。" },
